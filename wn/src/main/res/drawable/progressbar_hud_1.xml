<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="#000C0C0C"/>
            <stroke android:width="0.5dp" android:color="#00191919"/>
            <corners android:radius="@dimen/_100sdp"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape>
                <gradient android:startColor="#808080" android:endColor="#B2B2B2" android:angle="270.0" android:centerX="79.99999%" android:centerColor="#C6C6C6"/>
                <corners android:radius="@dimen/_100sdp"/>
            </shape>
        </scale>
    </item>
</layer-list>