<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="#003E3E3E"/>
            <stroke android:width="0.5dp" android:color="#00191919"/>
            <corners android:radius="@dimen/_100sdp"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape>
                <gradient android:startColor="#BB2A2A" android:endColor="#FF2D2D" android:angle="270.0" android:centerX="79.99999%" android:centerColor="#FF3C14"/>
                <corners android:radius="@dimen/_100sdp"/>
            </shape>
        </scale>
    </item>
</layer-list>