<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:id="@+id/menu_item"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="@dimen/_120sdp"
    android:layout_height="@dimen/_45sdp"
    android:layout_marginBottom="@dimen/_10sdp">

    <ImageView
        android:id="@+id/bcg_color_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background_br_input"/>

    <ImageView
        android:id="@+id/item_menu_image"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/_6sdp" />

    <TextView
        android:textSize="@dimen/_10sdp"
        android:textColor="@color/white"
        android:id="@+id/item_menu_name_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_1sdp"
        android:layout_below="@+id/item_menu_image"
        android:layout_centerHorizontal="true"
        android:fontFamily="@font/muller_bold"/>
</RelativeLayout>
