<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AppCompat.Light.NoActionBar.FullScreen" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="MyTheme" parent="@android:style/Theme.Holo.Dialog">
        <item name="android:textColorPrimary">#ffffff</item>
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:alertDialogStyle">@style/CustomAlertDialogStyle</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="PauseDialogAnimation" parent="">
        <item name="android:windowEnterAnimation">@anim/fadein</item>
        <item name="android:windowExitAnimation">@anim/fadeout</item>
    </style>

    <style name="CustomAlertDialogStyle" parent="">
        <item name="android:fullDark">@color/transparent</item>
        <item name="android:topDark">@color/transparent</item>
        <item name="android:centerDark">@color/transparent</item>
        <item name="android:bottomDark">@color/transparent</item>
        <item name="android:fullBright">@color/transparent</item>
        <item name="android:topBright">@color/transparent</item>
        <item name="android:centerBright">@color/transparent</item>
        <item name="android:bottomBright">@color/transparent</item>
        <item name="android:bottomMedium">@color/transparent</item>
        <item name="android:centerMedium">@color/transparent</item>
    </style>

    <style name="Theme.IAPTheme" parent="@android:style/Theme">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="PopupWindowAnimation">
        <item name="android:windowEnterAnimation">@anim/popup_show</item>
        <item name="android:windowExitAnimation">@anim/popup_hide</item>
    </style>

    <style name="PopupWindowAnimationNotification">
        <item name="android:windowEnterAnimation">@anim/popup_show_notification</item>
        <item name="android:windowExitAnimation">@anim/popup_hide_notification</item>
    </style>

    <style name="CircularDeterminateProgressBar">
        <item name="android:indeterminateOnly">false</item>
        <item name="android:progressDrawable">@drawable/circle</item>
    </style>

    <style name="AppBaseTheme" parent="@android:style/Theme.Light" />

    <style name="round_progressbar" parent="android:Widget.Holo.ProgressBar">
        <item name="android:layout_width">100dp</item>
        <item name="android:layout_marginLeft">8dp</item>
    </style>

    <style name="AppTheme" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="android:windowBackground">@drawable/back</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowFullscreen">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowTitleSize">0dp</item>

        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <style name="AppTheme.WithSplash">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowFullscreen">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowTitleSize">0dp</item>
    </style>

    <style name="MontserratBold12sp" parent="@android:style/Widget.TextView">
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
    </style>

    <style name="MontserratBold14sp" parent="@android:style/Widget.TextView">
        <item name="android:textSize">@dimen/_11sdp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
    </style>

    <style name="MontserratBold6sp" parent="@android:style/Widget.TextView">
        <item name="android:textSize">6.0sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
    </style>

    <style name="MontserratBold8sp" parent="@android:style/Widget.TextView">
        <item name="android:textSize">8.0sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
    </style>

    <style name="MontserratRegular12sp" parent="@android:style/Widget.TextView">
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">@font/montserrat_regular</item>
    </style>

    <style name="MontserratRegular14sp" parent="@android:style/Widget.TextView">
        <item name="android:textSize">@dimen/_11ssp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">@font/montserrat_regular</item>
    </style>

    <style name="MyTextViewTheme" parent="@android:style/Widget.TextView">
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
        <item name="android:textColorHint">@color/white</item>
        <item name="android:textColorTertiary">@color/white</item>
    </style>

    <style name="MontserratBold10spOr8ssp">
        <item name="android:textSize">@dimen/_8ssp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
    </style>

    <style name="MontserratBold11sdpOr14sp">
        <item name="android:textSize">@dimen/_11ssp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
    </style>

    <style name="MontserratRegular11sdpOr14sp">
        <item name="android:textSize">@dimen/_11ssp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">@font/montserrat_regular</item>
    </style>

    <style name="MontserratBold11sp">
        <item name="android:textSize">11.0sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
    </style>

    <style name="MontserratBold11spOr8ssp">
        <item name="android:textSize">@dimen/_8ssp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
    </style>

    <style name="tab_text" parent="@android:style/TextAppearance.Widget.TabWidget">
        <item name="android:scrollbarThumbVertical">@drawable/br_dialog_scroll_thumb</item>
        <item name="android:scrollbarTrackVertical">@drawable/br_dialog_scroll_track</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/muller_bold</item>
    </style>

    <style name="MyFont">
        <item name="android:fontFamily">@font/montserrat_bold</item>
    </style>

    <style name="MyRatingBar" parent="@style/Theme.AppCompat">
        <item name="colorControlActivated">#fff75514</item>
        <item name="colorControlNormal">#ff909090</item>
    </style>

    <style name="CustomCircularProgressBarStyle">
        <item name="indicatorColor">@color/black30</item>
        <item name="android:indeterminateTintMode">src_atop</item>
    </style>

    <dimen name="_10ssp" />
    <dimen name="_11ssp" />
    <dimen name="_8ssp" />
</resources>

